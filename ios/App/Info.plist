<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The Local Network prompt iOS puts up on the first socket to a
         device on the same Wi-Fi. This string is what the user reads while
         deciding, so it names the receiver rather than the API. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Javad Logger connects to your Javad receiver over the Wi-Fi network the receiver itself provides. Without this it cannot reach the receiver at all.</string>

    <!-- Files land in the app's own container. These two make that
         container visible in the Files app, which is the whole of "where
         the CSV goes" on iOS. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <key>UILaunchScreen</key>
    <dict/>

    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- Portrait only. The screen is a column of readings, and a rotation
         mid-session is a change of layout nobody asked for while watching
         a number. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
